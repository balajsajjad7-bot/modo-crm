# Neon Postgres (free tier) - copy the pooled connection string
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=30"

# Any long random string (used to sign login sessions)
JWT_SECRET="change-me-to-a-long-random-string"

# Your timezone offset from UTC in minutes (Pakistan = 300)
TZ_OFFSET_MIN=300

# AI: easiest is Admin → Tools → Connectors → AI provider. Or set it here.
# Groq (free, fastest): https://console.groq.com/keys  → AI_PROVIDER="groq"  AI_MODEL="openai/gpt-oss-120b"
# Gemini (free): https://aistudio.google.com/apikey
AI_PROVIDER="groq"            # groq | gemini | anthropic
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"

# VICIdial Non-Agent API - create a dedicated API user in VICIdial, never your admin login
VICIDIAL_URL="http://your-vicidial-server"
VICIDIAL_API_USER=""
VICIDIAL_API_PASS=""

# First admin account (used once by `npm run seed`)
ADMIN_ID="ADMIN"
ADMIN_PASSWORD="change-me"

# Optional: TURN server for calls/huddles on strict networks (e.g. free tier at metered.ca)
TURN_URL=""
TURN_USER=""
TURN_PASS=""

# Optional: separate key for encrypting secrets in the database (defaults to one derived from JWT_SECRET).
# If you set it, never change it later or saved SMTP/API passwords can't be read.
ENCRYPTION_KEY=""
